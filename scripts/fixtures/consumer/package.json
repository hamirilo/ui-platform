{
  "name": "verify-application-ui-kit-consumer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "verify-package.sh 用の最小利用側プロジェクト。実アプリの input.css / islands 構成を模して、tarball 化した配布物が非巻き上げレイアウトでもビルドできることを確認する。",
  "scripts": {
    "build:css": "tailwindcss -i backend/static/css/input.css -o backend/static/css/output.css",
    "build:islands": "vite build",
    "check:bundle": "vite build -c vite.bundle.config.ts && node check-bundle.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.3"
  }
}
