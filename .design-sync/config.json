{
  "shape": "storybook",
  "storybookConfigDir": ".storybook",
  "storybookStatic": ".design-sync/sb-reference",
  "pkg": "application-ui-kit",
  "globalName": "ApplicationUiKit",
  "entry": "dist/components/application/index.js",
  "buildCmd": "bun run build",
  "readmeHeader": ".design-sync/conventions.md",
  "docsMap": {
    "Accordion": ".design-sync/docs/component-group.md",
    "ActiveIndicator": ".design-sync/docs/component-group.md",
    "Alert": ".design-sync/docs/component-group.md",
    "Avatar": ".design-sync/docs/component-group.md",
    "Badge": ".design-sync/docs/component-group.md",
    "Breadcrumbs": ".design-sync/docs/component-group.md",
    "Button": ".design-sync/docs/component-group.md",
    "ButtonGroup": ".design-sync/docs/component-group.md",
    "Checkbox": ".design-sync/docs/component-group.md",
    "Combobox": ".design-sync/docs/component-group.md",
    "ConfirmDialog": ".design-sync/docs/component-group.md",
    "CopyButton": ".design-sync/docs/component-group.md",
    "DatePicker": ".design-sync/docs/component-group.md",
    "DescriptionList": ".design-sync/docs/component-group.md",
    "Dialog": ".design-sync/docs/component-group.md",
    "Dropdown": ".design-sync/docs/component-group.md",
    "FileDropZone": ".design-sync/docs/component-group.md",
    "FormDialog": ".design-sync/docs/component-group.md",
    "FormField": ".design-sync/docs/component-group.md",
    "FormFieldSet": ".design-sync/docs/component-group.md",
    "Input": ".design-sync/docs/component-group.md",
    "NavItem": ".design-sync/docs/component-group.md",
    "PageHeader": ".design-sync/docs/component-group.md",
    "Pagination": ".design-sync/docs/component-group.md",
    "Popover": ".design-sync/docs/component-group.md",
    "RadioGroup": ".design-sync/docs/component-group.md",
    "RadioTable": ".design-sync/docs/component-group.md",
    "ScopeSearch": ".design-sync/docs/component-group.md",
    "SearchInput": ".design-sync/docs/component-group.md",
    "Select": ".design-sync/docs/component-group.md",
    "Stat": ".design-sync/docs/component-group.md",
    "Steps": ".design-sync/docs/component-group.md",
    "Switch": ".design-sync/docs/component-group.md",
    "Table": ".design-sync/docs/component-group.md",
    "Tabs": ".design-sync/docs/component-group.md",
    "Textarea": ".design-sync/docs/component-group.md",
    "ThemeToggle": ".design-sync/docs/component-group.md",
    "Toaster": ".design-sync/docs/component-group.md",
    "Tooltip": ".design-sync/docs/component-group.md",
    "TreeSelect": ".design-sync/docs/component-group.md"
  },
  "titleMap": {
    "Toast": "Toaster"
  },
  "overrides": {
    "Pagination": { "cardMode": "column" },
    "Table": { "viewport": "900x1150" },
    "NavItem": { "viewport": "900x1100" },
    "FormField": { "viewport": "900x1020" },
    "Input": { "viewport": "900x980" },
    "ButtonGroup": { "viewport": "900x900" },
    "Combobox": { "viewport": "900x870" },
    "DatePicker": { "viewport": "900x870" },
    "RadioGroup": { "viewport": "900x1600" },
    "Select": { "viewport": "900x780" },
    "Alert": { "viewport": "900x950" },
    "FileDropZone": { "viewport": "900x1150" },
    "FormFieldSet": { "viewport": "900x1020" },
    "RadioTable": { "viewport": "900x1100", "cardMode": "column" },
    "Steps": { "viewport": "900x870" },
    "TreeSelect": { "viewport": "900x870" }
  }
}
