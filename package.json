{
  "name": "@hamirilo/application-ui-kit",
  "version": "7.2.1",
  "description": "Shared React application UI components, semantic design tokens, and Storybook specification",
  "type": "module",
  "sideEffects": [
    "**/auto-mount.tsx",
    "dist/components/islands/auto-mount.js",
    "**/*.css"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "bunx --bun @biomejs/biome@1.9.4 check .",
    "verify:package": "bash ./scripts/verify-package.sh",
    "format": "bunx --bun @biomejs/biome@1.9.4 check --write ."
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/components/application/index.js",
  "module": "./dist/components/application/index.js",
  "types": "./dist/types/components/application/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/components/application/index.d.ts",
      "import": "./dist/components/application/index.js"
    },
    "./islands": {
      "types": "./dist/types/components/islands/index.d.ts",
      "import": "./dist/components/islands/index.js"
    },
    "./islands/auto-mount": {
      "types": "./dist/types/components/islands/auto-mount.d.ts",
      "import": "./dist/components/islands/auto-mount.js"
    },
    "./styles.css": "./tokens/theme.css",
    "./tokens/*": "./tokens/*"
  },
  "files": [
    "dist",
    "components",
    "lib",
    "tokens"
  ],
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.33.0",
    "react-day-picker": "^10.0.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-sans-jp": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "happy-dom": "^17.6.3",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
